[Unit]
Description=WGM agent (converge + observer)
After=network.target

# Агент применяет сохранённые конфигурации инстансов при своём старте
# (apply-at-boot). Это обеспечивает автономность узла: туннели поднимаются
# даже если контроллер недоступен.
#
# Управляемые WGM инстансы хранят конфиги в /etc/wireguard/wgm/ и
# /etc/amnezia/amneziawg/wgm/; шаблонные юниты wg-quick@/awg-quick@ эти
# пути не подхватывают, поэтому ordering относительно них не требуется.
# Жизненным циклом туннелей управляет сам агент.

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/wgm/current
Environment=HOME=/root
Environment=WGM_MODE=agent
EnvironmentFile=-/etc/wgm/cookie.env
EnvironmentFile=-/etc/wgm/agent.env
ExecStart=/opt/wgm/current/bin/wgm start
ExecStop=/opt/wgm/current/bin/wgm stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
