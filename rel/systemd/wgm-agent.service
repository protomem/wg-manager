[Unit]
Description=WGM agent (converge + observer)
After=network.target
Before=wg-quick@.service awg-quick@.service

# Агент применяет сохранённые конфигурации инстансов при своём старте
# (apply-at-boot). Это обеспечивает автономность узла: туннели поднимаются
# даже если контроллер недоступен. systemd-юниты wg-quick@/awg-quick@
# для управляемых WGM инстансов не используются — жизненным циклом
# управляет сам агент.

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/wgm/current
Environment=HOME=/root
Environment=WGM_MODE=agent
EnvironmentFile=-/etc/wgm/cookie.env
EnvironmentFile=-/etc/wgm/agent.env
ExecStart=/opt/wgm/current/bin/wgm start
ExecStop=/opt/wgm/current/bin/wgm stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
