[Unit]
Description=WGM agent (read-only observer)
After=network.target
# В read-only фазе (срез 4) агент только наблюдает и не пишет конфиги
# инстансов, поэтому строгий ordering относительно wg-quick@/awg-quick@
# пока не требуется. Реальный порядок (Before= на сгенерированные
# инстансовые юниты + ExecStartPre) будет добавлен в срезе 6, когда агент
# начнёт сводить фактическое состояние к желаемому.

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/wgm/current
Environment=HOME=/root
Environment=WGM_MODE=agent
Environment=WGM_AGENT_READ_ONLY=true
EnvironmentFile=-/etc/wgm/cookie.env
EnvironmentFile=-/etc/wgm/agent.env
ExecStart=/opt/wgm/current/bin/wgm start
ExecStop=/opt/wgm/current/bin/wgm stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
