# Параметры контроллера.
# Скопируйте в /etc/wgm/controller.env на узле контроллера.

# Erlang distribution: длинное имя по IP-адресу контроллера.
RELEASE_DISTRIBUTION=name
RELEASE_NODE=wgm_controller@5.129.219.31

# Фиксированный dist-порт контроллера (плюс epmd 4369 должен быть доступен к агентам).
# На узле, где совмещаются агент и контроллер, порты должны различаться.
ERL_AFLAGS="-kernel inet_dist_listen_min 9101 inet_dist_listen_max 9101"

# WGM_DB_PATH=/var/lib/wgm/controller.db
