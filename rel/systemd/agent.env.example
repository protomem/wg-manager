# Параметры агента для конкретного узла.
# Скопируйте в /etc/wgm/agent.env и заполните значениями узла.

WGM_NODE_ID=node-1
WGM_NODE_NAME=entry
WGM_NODE_ADDRESS=193.233.91.130
WGM_NODE_ROLE=entry
WGM_NODE_DESCRIPTION="Entry node"

# Erlang distribution: длинное имя по IP-адресу узла.
RELEASE_DISTRIBUTION=name
RELEASE_NODE=wgm_agent@193.233.91.130

# Фиксированный dist-порт агента (плюс epmd 4369 должен быть доступен с контроллера).
ERL_AFLAGS="-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9100"

# Read-only наблюдение за интерфейсами.
# Формат: id:protocol:name:listen_port:subnet:address|...
# protocol — wg или awg; для read-only режима важны только protocol и name.
WGM_AGENT_INSTANCES="legacy-wg0:wg:wg0:51820:10.10.0.0/24:10.10.0.1/24|legacy-awg0:awg:awg0:51821:10.11.0.0/24:10.11.0.1/24"
